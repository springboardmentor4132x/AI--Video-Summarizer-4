# ---------------------------------------------------------------------------
# ClipMind AI backend — environment configuration
# Copy this file to .env and fill in real values. Never commit a real .env.
#
# Every AI feature in this application (transcription, summarization,
# Q&A, translation) runs on locally-executed open-source models.
# There is NO OpenAI dependency anywhere in this application, and
# therefore NO API key of any kind is required to run it.
# ---------------------------------------------------------------------------

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=clipmindAI

# --- Auth ---
# Required. Generate a real random secret, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage ---
UPLOAD_DIR=uploaded_videos
MAX_UPLOAD_SIZE_MB=500

# --- CORS ---
# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# --- Local AI models (all local; first use downloads + caches weights) ---
# Transcription: local Whisper models. The base model is used for auto
# and English transcription. Hindi uses large-v3-turbo for more reliable
# Devanagari output (~1.5GB download; allow several GB RAM for CPU inference).
WHISPER_MODEL_NAME=base
WHISPER_HINDI_MODEL_NAME=large-v3-turbo
# Summarization: any Hugging Face seq2seq summarization checkpoint.
SUMMARIZATION_MODEL_NAME=facebook/bart-large-cnn
# Translation: NLLB-200 covers all 6 target languages with one model.
# ~2.4GB download. A GPU is not required (CPU inference works, just
# slower); torch.cuda.is_available() is checked automatically.
TRANSLATION_MODEL_NAME=facebook/nllb-200-distilled-600M

# --- Optional: PDF export in non-English scripts ---
# Path to a Unicode TTF font file covering the target script (e.g. Noto
# Sans Telugu / Devanagari / Tamil / Kannada / Malayalam / Bengali).
# English PDF export works without this.
# PDF_UNICODE_FONT_PATH=/path/to/NotoSansTelugu-Regular.ttf

# --- ClipMind Story ---
# No new variables. Story reuses UPLOAD_DIR (frames are written to
# UPLOAD_DIR/story_frames/) and needs FFmpeg on PATH, like clip generation.


# --- Real-Time Workspace (optional) ---
# Private Netscape-format cookie export for YouTube streams that require sign-in.
# Never commit this file.
# YOUTUBE_COOKIES_FILE=/secure/path/youtube-cookies.txt
